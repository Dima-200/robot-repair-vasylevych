<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Background" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/SugarLand/UI/UIDialogueBox.png?fileID=2800000&amp;guid=cd17cea45c10d0943a1a8f2485b35902&amp;type=3#UIDialogueBox&quot;); font-size: 40px;">
        <ui:Label text="Тисни C, щоб стріляти шестернями, і допоможи полагодити ці зламані роботи! Повертайся, коли закінчиш" style="width: 100%; height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 25px; padding-right: 25px; padding-bottom: 25px; padding-left: 25px; white-space: normal;"/>
    </ui:VisualElement>
    <ui:Label text="Твоє завдання — пройти рівень і полагодити всіх роботів. Обережно! Уникай ворогів і небезпечних зон. Підказка: шукай аптечки після небезпечних ділянок, щоб відновити здоров&apos;я." style="font-size: 20px;"/>
</ui:UXML>

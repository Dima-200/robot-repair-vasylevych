<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="LoseScreenContainer" style="flex-grow: 1; position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-color: rgb(0, 0, 0); opacity: 0; transition-property: opacity; transition-duration: 1s;">
        <ui:VisualElement name="LoseScreen" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Tutorial_Demo/Demo_Art/Common/LoseScreen.png?fileID=2800000&amp;guid=68999694f4e00437a8c4f0b6053e3d45&amp;type=3#LoseScreen&quot;); -unity-background-scale-mode: scale-to-fit;"/>
        <ui:Button name="LoseRestartButton" text="Спробувати ще раз" style="position: absolute; bottom: 7%; left: 35%; width: 30%; height: 8%; font-size: 24px;" />
    </ui:VisualElement>
    <ui:VisualElement name="WinScreenContainer" style="flex-grow: 1; position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-color: rgb(0, 0, 0); transition-property: opacity; transition-duration: 1s; opacity: 0;">
        <ui:VisualElement name="WinScreen" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Tutorial_Demo/Demo_Art/Common/WinScreen.png?fileID=2800000&amp;guid=d46766d63d5ca44c6b1a4d318b1eaf72&amp;type=3#WinScreen&quot;); -unity-background-scale-mode: scale-to-fit;"/>
        <ui:Button name="WinRestartButton" text="Зіграти ще раз" style="position: absolute; bottom: 7%; left: 35%; width: 30%; height: 8%; font-size: 24px;" />
    </ui:VisualElement>
    <ui:VisualElement name="StartScreenContainer" style="flex-grow: 1; position: absolute; top: 0; right: 0; bottom: 0; left: 0; align-items: center; justify-content: center; background-color: rgb(20, 28, 35);">
        <ui:Label text="ROBOT REPAIR" style="font-size: 54px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-bottom: 18px;" />
        <ui:Label text="Полагодь усіх зламаних роботів і дістанься до виходу." style="font-size: 24px; color: rgb(238, 238, 238); margin-bottom: 30px;" />
        <ui:Button name="StartButton" text="Почати гру" style="width: 250px; height: 60px; font-size: 26px;" />
    </ui:VisualElement>
</ui:UXML>
